# Copie para um arquivo fora do repositório e substitua todos os placeholders.
APP_IMAGE=ghcr.io/odecius/prospect@sha256:replace-with-immutable-digest
APP_VERSION=replace-with-release-version
APP_PORT=8000
APP_NAME=ABC Prospect
LOG_LEVEL=INFO

POSTGRES_DB=abc_prospect
POSTGRES_USER=abc_prospect
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Codifique caracteres reservados da senha para uso na URL.
DATABASE_URL=postgresql+psycopg://abc_prospect:replace-with-url-encoded-secret@db:5432/abc_prospect
APP_SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800

# Integrações permanecem desativadas até seus controles externos serem aprovados.
GOOGLE_PLACES_API_KEY=
WEBSITE_AUDIT_ENABLED=false
WEBSITE_AUDIT_EGRESS_CONTROLLED=false
AI_DRAFTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
