APP_ENV=development
APP_NAME=ABC Prospect
APP_VERSION=0.1.0
LOG_LEVEL=INFO
POSTGRES_DB=abc_prospect
POSTGRES_USER=abc_prospect
POSTGRES_PASSWORD=development-only-change-me
DATABASE_URL=postgresql+psycopg://abc_prospect:development-only-change-me@db:5432/abc_prospect
APP_SECRET_KEY=development-only-secret-key-change-me
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=5
GOOGLE_PLACES_MAX_RETRIES=2
GOOGLE_PLACES_PAGE_SIZE=10
GOOGLE_PLACES_MAX_PAGES=2
GOOGLE_PLACES_REQUESTS_PER_MINUTE=5
# Usadas somente pelo comando explícito `python -m scripts.create_admin`.
ADMIN_EMAIL=admin@example.invalid
ADMIN_DISPLAY_NAME=Administrador
ADMIN_PASSWORD=development-only-change-me
